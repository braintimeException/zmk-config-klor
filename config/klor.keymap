    keymap {
        compatible = "zmk,keymap";
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄


                prorak_layer {
//  ┌───────────────────────────────────────────────────────────┐
label= "PRORAK"                                                 ;
//  └───────────────────────────────────────────────────────────┘
/*            ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
              │    ;    │    ,    │    .    │    P    │    Y    │                    │    F    │    G    │    C    │    R    │    L    │
    ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
    │   XXX   │    A    │    O    │    E    │    U    │    I    │                    │    D    │    H    │    T    │    N    │    S    │   XXX   │
    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    │   XXX   │    "    │ Q/LALT  │ J/LCTRL │ K/LGUI  │    X    ││  MUTE  ││PLY/PSE ││    B    │ M/RGUI  │ W/RCTRL │ V/RALT  │    Z    │   XXX   │
    └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                  │  LSHFT  │  SPACE  │  FNUM   │ TAB/FSYM││  ENTER  │  NAVIG  │  BSPCE  │  RSHFT  │
                                  └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */
 bindings = <
 //|          ╷         ╷           ╷            ╷           ╷         ╷               ╷╷         ╷         ╷           ╷            ╷           ╷         ╷
              &kp SEMI  &kp COMMA   &kp DOT      &kp P       &kp Y                                &kp F     &kp G       &kp C        &kp R       &kp L
    &trans    &kp A     &kp O       &kp E        &kp U       &kp I                                &kp D     &kp H       &kp T        &kp N       &kp S      &trans
    &trans    &kp SQT   &hml LALT Q &hml LCTRL J &hml LGUI K &kp X     &trans           &trans    &kp B     &hmr RGUI M &hmr RCTRL W &hmr RALT V &kp Z      &trans
