/*            ┌─────────┬─────────┬─────────┬─────────┬─────────┐                    ┌─────────┬─────────┬─────────┬─────────┬─────────┐
              │  Dm     │  Em     │  E      │  G7     │  C7     │                    │  A#3    │  C#4    │         │  F#3    │  G#3    │
    ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤                    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
    │   XXX   │  C      │  G      │  Am     │  F      │  D      │                    │  C4     │  D4     │  E4     │  F4     │  G4     │   XXX   │
    ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤╭────────╮╭────────╮├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    │   XXX   │  Bass C │  Bass G │  Bass A │  Bass F │  Bass D ││  MUTE  ││PLY/PSE ││  F3     │  G3     │  A3     │  B3     │  C4     │   XXX   │
    └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┼╰────────╯╰────────╯┼─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                  │ OCT DN  │ OCT UP  │ MLOWER  │DEEP BASS││  SPACE  │ SUSTAIN │ VEL DN  │ VEL UP  │
                                  └─────────┴─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┴─────────┘ */
 bindings = <
 //|          ╷         ╷         ╷         ╷          ╷         ╷          ╷╷         ╷         ╷         ╷         ╷         ╷         ╷
              &chord_dm &chord_em &chord_e  &chord_g7  &chord_c7                       &kp U     &kp O     &trans    &kp T     &kp Y
    &trans    &chord_c  &chord_g  &chord_am &chord_f   &chord_d                        &kp K     &kp L     &kp SEMI  &kp SQT   &kp B     &trans
    &trans    &kp A     &kp G     &kp H     &kp F      &kp S     &trans     &trans     &kp F     &kp G     &kp H     &kp J     &kp K     &trans
                                            &kp Z      &kp X     &mo MLOWER &kp A      &kp SPACE &kp LSHFT &kp C     &kp V
                        >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄


